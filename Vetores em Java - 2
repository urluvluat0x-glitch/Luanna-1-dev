
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        int[] numeros = new int[8];
        int[] positivos = new int[8];
        int[] negativos = new int[8];

        int p = 0, n = 0;

        for (int i = 0; i < 8; i++) {
            System.out.print("Digite um número inteiro: ");
            numeros[i] = entrada.nextInt();

            if (numeros[i] > 0) {
                positivos[p] = numeros[i];
                p++;
            } else if (numeros[i] < 0) {
                negativos[n] = numeros[i];
                n++;
            }
        }

        System.out.println("\nNúmeros positivos:");
        for (int i = 0; i < p; i++) {
            System.out.print(positivos[i] + " ");
        }

        System.out.println("\n\nNúmeros negativos:");
        for (int i = 0; i < n; i++) {
            System.out.print(negativos[i] + " ");
        }

        entrada.close();
    }
}
