
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner entrada = new Scanner(System.in);

        double nota1, nota2, media;
        int faltas;

        System.out.print("Digite a primeira nota: ");
        nota1 = entrada.nextDouble();

        System.out.print("Digite a segunda nota: ");
        nota2 = entrada.nextDouble();

        System.out.print("Digite a quantidade de faltas: ");
        faltas = entrada.nextInt();

        // Verificar se as notas são válidas
        if (nota1 < 0 || nota1 > 10 ||
            nota2 < 0 || nota2 > 10) {

            System.out.println("Erro! As notas devem estar entre 0 e 10.");

        } else {
            media = (nota1 + nota2) / 2;

            System.out.println("Média: " + media);

            if (faltas > 25) {
                System.out.println("Situação: Reprovado por falta");
            } 
            else if (media >= 7) {
                System.out.println("Situação: Aprovado");
            } 
            else if (media >= 4) {
                System.out.println("Situação: Em recuperação");
            } 
            else {
                System.out.println("Situação: Reprovado");
            }
        }

        entrada.close();
    }
}
